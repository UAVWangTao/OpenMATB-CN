#, python-format
msgid ""
"In config.ini, the specified screen index exceeds the number of available "
"screens (%s). Last screen selected."
msgstr "config.ini 中指定的屏幕索引超过可用屏幕数 (%s)，已选择最后一块屏幕。"

#: core/window.py:45
msgid ""
"In config.ini, the specified font is not available. A default font will be "
"used."
msgstr "config.ini 中指定的字体不可用，将使用默认字体。"

#: core/window.py:166
msgid "You hit the Escape key"
msgstr "您按下了 Escape 键"

#: core/window.py:166
