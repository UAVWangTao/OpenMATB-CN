#: core/scenario.py:82
#, python-format
msgid "%s was not found"
msgstr "未找到 %s"

#: core/scenario.py:98
#, python-format
msgid "Scenario error: %s is not a valid plugin name (l. %s)"
msgstr "场景错误：%s 不是有效的插件名（第 %s 行）"

#: core/scenario.py:112
msgid "No error"
msgstr "无错误"

#: core/scenario.py:116
#, python-format
msgid "There were some errors in the scenario. See the %s file."
msgstr "场景中存在错误，请查看 %s 文件。"

#: core/scenario.py:184
#, python-format
msgid "The (%s) plugin does not have a start command."
msgstr "插件 (%s) 没有启动命令。"

#: core/scenario.py:188
#, python-format
msgid "The (%s) plugin does not have a stop command."
msgstr "插件 (%s) 没有停止命令。"

#: core/scenario.py:197
#, python-format
msgid "Error on line %s. This event does not trigger any command."
msgstr "第 %s 行错误：该事件未触发任何命令。"

#: core/scenario.py:201
#, python-format
msgid "Error on line %s. Maximum length of an event is 2 (parameter;value)."
msgstr "第 %s 行错误：事件最大长度为 2（参数;值）。"

#: core/scenario.py:208
#, python-format
msgid "Error on line %s. Method (%s) is not available for the plugin (%s)"
msgstr "第 %s 行错误：插件 (%s) 不支持方法 (%s)"

#: core/scenario.py:225
#, python-format
msgid "Warning on line %s. Parameter (%s) has no verification method"
msgstr "第 %s 行警告：参数 (%s) 没有校验方法"

#: core/scenario.py:243
#, python-format
msgid "Error on line %s. %s "
msgstr "第 %s 行错误：%s "

#: core/scenario.py:250
#, python-format
msgid "Error on line %s. The %s plugin does not have a %s parameter"
msgstr "第 %s 行错误：插件 %s 没有参数 %s"

#: core/scenario.py:270
#, python-format
msgid "should be a string (not %s)."
msgstr "应为字符串（不是 %s）。"

#: core/scenario.py:274
#, python-format
msgid "should be a natural (0 included) integer (not %s)."
msgstr "应为自然数（含 0）整数（不是 %s）。"

#: core/scenario.py:291
#, python-format
msgid "should be a positive (0 excluded) integer (not %s)."
msgstr "应为正整数（不含 0）（不是 %s）。"

#: core/scenario.py:298
#, python-format
msgid "should be a boolean (not %s)."
msgstr "应为布尔值（不是 %s）。"

#: core/scenario.py:314
#, python-format
msgid "must be (R,G,B,a) or hexadecimal (e.g., #00ff00) values (not %s)"
msgstr "必须为 (R,G,B,a) 或十六进制（如 #00ff00）格式（不是 %s）"

#: core/scenario.py:320
#, python-format
msgid "should be (R,G,B,a) values each comprised between 0 and 255 (not %s)"
msgstr "应为 0 到 255 之间的 (R,G,B,a) 值（不是 %s）"

#: core/scenario.py:325
#, python-format
msgid "should be a positive float (not %s)"
msgstr "应为正浮点数（不是 %s）"

#: core/scenario.py:360
#, python-format
msgid "should be comprised in %s (not %s)"
msgstr "应在 %s 范围内（不是 %s）"

#: core/scenario.py:367
#, python-format
msgid "should be a valid regex expression (not %s)"
msgstr "应为有效的正则表达式（不是 %s）"

#: core/scenario.py:377
#, python-format
msgid "should be an acceptable keyboard key value (not %s). See documentation."
msgstr "应为可接受的键盘键值（不是 %s）。请参阅文档。"

#: core/scenario.py:393
#, python-format
msgid "should be composed of letters [a-z] or digits [0-9] (not %s in %s)"
msgstr "应由字母 [a-z] 或数字 [0-9] 组成（在 %s 中不是 %s）"

#: core/scenario.py:408
#, python-format
msgid "should be composed of valid callsigns (not %s)"
msgstr "应由有效的呼号组成（不是 %s）"

#: core/scenario.py:412
#, python-format
msgid "should be a float between 0 and 1 (included) (not %s)"
msgstr "应为 0 到 1（含）之间的浮点数（不是 %s）"

#: core/scenario.py:431
#, python-format
msgid ""
"should be available either in the Instruction or Questionnaire folder (not "
"%s)"
msgstr "应在说明或问卷文件夹中存在（不是 %s）"

#: core/scheduler.py:66
#, python-format
msgid "Session ID: %s"
msgstr "会话 ID：%s"

#: core/widgets/timeline.py:33
msgid "min."
msgstr "分钟"

