msgstr "是否退出 OpenMATB？"

#: core/window.py:170
msgid "Pause"
msgstr "暂停"

#: core/window.py:209
#, python-format
msgid "Error. No placement found for the [%s] alias"
msgstr "错误：未找到 [%s] 别名的布局位置"

#: main.py:37
#, python-format
msgid ""
"In config.ini, [%s] parameter must be a boolean (true or false, not %s). "
"Defaulting to False"
msgstr "config.ini 中 [%s] 参数必须为布尔值（true 或 false，不是 %s），已默认为 False"

